Attribute VB_Name = "SHTBST_90_Test"
Option Explicit

'==============================================================================
' SHTBST_90_Test
'------------------------------------------------------------------------------
' Excel Worksheet Boosters
' SHTBST - Sheet Store Booster
'
' SHTBSTのStore / Restore機能を確認するためのテストモジュールです。
'
' 実際のアプリケーションでは、使用するアプリ側から
' StoreRange / RestoreRangeを呼び出してください。
'
' このモジュールでは、Sheet1のAREA_INFOをテスト対象とします。
'
' Sheet1!B2
'   → Store ID
'
' AREA_INFO
'   → Store / Restore対象範囲
'==============================================================================


'==============================================================================
' Test_Save
'------------------------------------------------------------------------------
' テスト対象範囲のデータをStoreします。
'
' Sheet1!B2に指定されたIDをStore IDとして使用します。
'
' 例：
'
'   B2 = 1
'   AREA_INFO = "E5:W20"
'
' の場合、
'
'   Sheet1.Range("E5:W20")
'
' がStore ID 1として保管されます。
'==============================================================================

Private Sub Test_Save()

    StoreRange _
        Sheet1.Range(AREA_INFO), _
        CLng(Sheet1.Range("B2").Value)

End Sub


'==============================================================================
' Test_Load
'------------------------------------------------------------------------------
' Test_Saveで保管したデータをRestoreします。
'
' Sheet1!B2に指定されたIDをStore IDとして使用します。
'
' テストでは、Test_Saveを実行したあと、
' AREA_INFOの内容を意図的に変更または削除してから
' Test_Loadを実行すると、Store時の状態へ戻ることを確認できます。
'==============================================================================

Private Sub Test_Load()

    RestoreRange _
        CLng(Sheet1.Range("B2").Value)

End Sub
