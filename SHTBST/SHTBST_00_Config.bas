Attribute VB_Name = "SHTBST_00_Config"
Option Explicit

'==============================================================================
' SHTBST_00_Config
'------------------------------------------------------------------------------
' Excel Worksheet Boosters
' SHTBST - Sheet Store Booster
'
' ワークシート上のデータを一時保管し、
' 必要に応じて元の状態へ復元するための設定を管理します。
'
' 保存対象：
'   ・セルのValue
'
' 保存される情報：
'   ・Store ID
'   ・Sheet Name
'   ・Range Address
'   ・Rows
'   ・Columns
'   ・Range Value
'
' ※ このモジュールでは、アプリケーション固有の
'    データ構造やルーラー情報は扱いません。
'==============================================================================


'------------------------------------------------------------------------------
' Store Sheet
'------------------------------------------------------------------------------
' 保管データを格納するワークシート名
'
' 必要に応じて、利用するブック側でこの名前のシートを用意します。
'------------------------------------------------------------------------------

Public Const SHTBST_STORE_SHEET_NAME As String = "SHTBST_STORE"


'------------------------------------------------------------------------------
' Store Format
'------------------------------------------------------------------------------
' 保管データの先頭位置
'
' 1列 = 1 Store ID
'------------------------------------------------------------------------------

Public Const SHTBST_STORE_HEADER_ROW As Long = 1


'------------------------------------------------------------------------------
' Store Header
'------------------------------------------------------------------------------
' 保管領域で使用する行番号
'------------------------------------------------------------------------------

Public Const SHTBST_ROW_ID As Long = 1
Public Const SHTBST_ROW_SHEET As Long = 2
Public Const SHTBST_ROW_RANGE As Long = 3
Public Const SHTBST_ROW_ROWS As Long = 4
Public Const SHTBST_ROW_COLUMNS As Long = 5
Public Const SHTBST_ROW_DATA_START As Long = 6


'------------------------------------------------------------------------------
' Main Application Area
'------------------------------------------------------------------------------
' SHTBSTでStore / Restoreの対象となるメイン領域を指定します。
'
' アプリケーション側で、自分が使用するワークシート上の範囲を
' Public Constとして定義してください。
'
' 例：
'   Public Const AREA_INFO As String = "E5:W20"
'
' SHTBSTは、この範囲の内容を一時保管し、
' 必要に応じて元の状態へRestoreします。
'
' ※ SHTBST自体は、AREA_INFOの具体的な意味を持ちません。
'    アプリケーションが使用する領域を指定するための設定です。
'------------------------------------------------------------------------------

Public Const AREA_INFO As String = "E5:W20"

